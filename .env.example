# Copy to .env (never commit .env).
# Token used locally for the answer model and for deploying (needs write access to deploy).
HF_TOKEN=hf_your_token_here
# Separate fine-grained token stored in the Space: only "Make calls to Inference Providers".
HF_SPACE_TOKEN=hf_inference_only_token_here
# Answer model on Groq's free tier (no card): create a key at console.groq.com/keys.
# When set, Ask RBI uses Groq instead of Hugging Face credits, locally and in the Space.
GROQ_API_KEY=
